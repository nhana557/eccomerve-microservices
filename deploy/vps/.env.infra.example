# ==============================================================================
# T.STORE VPS DEPLOYMENT: DATABASE & OBSERVABILITY STACK CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL & PGBOUNCER
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword_change_me_in_vps
POSTGRES_DB=postgres
# Port PostgreSQL yang diekspos ke host VPS (default: 5432)
POSTGRES_PORT=5432

# Port PgBouncer connection pooler (default: 6432)
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ------------------------------------------------------------------------------
# 2. REDIS CACHE
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. RABBITMQ MESSAGE BROKER
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guestpassword_change_me_in_vps
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------------------------------------------
# 4. ELASTICSEARCH (CQRS SEARCH ENGINE)
# ------------------------------------------------------------------------------
ES_PORT=9200
# Alokasi RAM JVM Elasticsearch:
# - VPS RAM 2GB: -Xms512m -Xmx512m
# - VPS RAM 4GB: -Xms1g -Xmx1g (Direkomendasikan)
# - VPS RAM 8GB+: -Xms2g -Xmx2g
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY STACK
# ------------------------------------------------------------------------------
# Jaeger Tracing Web UI
JAEGER_PORT=16686

# Loki Log Aggregator
LOKI_PORT=3100

# Grafana Alloy OTel Receiver
ALLOY_GRPC_PORT=4317
ALLOY_HTTP_PORT=4318
ALLOY_UI_PORT=12345

# Prometheus Metrics Engine
PROMETHEUS_PORT=9090

# Grafana Monitoring Dashboard
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword_change_me_in_vps
GRAFANA_PORT=3010

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE EDGE OBSERVABILITY EXPORTER
# ------------------------------------------------------------------------------
# API Token Cloudflare dengan permission: Zone:Read, Analytics:Read
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Zone ID domain (dari Overview domain di dashboard Cloudflare)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
# Set true jika domain menggunakan akun Cloudflare Free Tier
CLOUDFLARE_FREE_TIER=true
CLOUDFLARE_EXPORTER_PORT=8085
