# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION (VPS)
# ==========================================

# GitHub Username / Organization yang memiliki image GHCR
GHCR_OWNER=nhana557

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword_change_me_in_prod
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# RabbitMQ Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guestpassword_change_me_in_prod

# JWT Secret
JWT_SECRET=your-super-strong-jwt-secret-key-for-prod-2026

# Public Gateway URL (IP VPS atau Domain Publik yang bisa diakses peramban)
# Contoh: http://103.123.45.67:8080 atau https://api.tstore.id
PUBLIC_GATEWAY_URL=http://localhost:8080

# Path ke docker config.json di VPS (untuk login private GHCR)
DOCKER_CONFIG_PATH=/root/.docker/config.json
